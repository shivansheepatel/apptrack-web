# Copy to .env.local for `npm run dev` / the engine scripts, or to whatever
# file your deploy target reads (e.g. EnvironmentFile for the systemd unit
# in docs/HOMELAB.md). Never commit the real values.

# --- /admin/review authentication (src/lib/admin-auth.ts) -----------------
# Generate both of these with:  node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Set to 1 only if this process sits behind a reverse proxy you control,
# so the admin-login rate limiter can key on the real client IP
# (X-Forwarded-For) instead of the proxy's IP. Leaving it unset is the safe
# default if you're not sure.
TRUST_PROXY=

# The admin session cookie is marked Secure by default in production, which
# browsers only store/send over https://. If this deployment is served over
# plain http:// (e.g. a home-network box with no TLS in front of it), set
# this to 0 so the login session actually persists. Leave it unset for any
# deployment reachable over https.
ADMIN_COOKIE_SECURE=

NODE_ENV=production

# --- Google Sheet sync (scripts/engine/sheet.mts) --------------------------
# Same Master Tracker sheet the Discord bot reads. Must be shared as
# "Anyone with the link can view" (no OAuth/service account needed). Get the
# ID from the sheet's own URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=153dlgd76lckoDshnl_xSvZBKY18vRHLE8QCPrPa6Xd8
# Which tab (found in the URL after "#gid=").
GOOGLE_SHEET_GID=1704917990
